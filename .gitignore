# ── 密钥与本地配置 ──────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.so
.venv/
venv/
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── 运行期产物（runs/ 下随附的定版产物要入库，其余不进来）──────────────────
logs/*
!logs/.gitkeep
memory/*
!memory/.gitkeep
runs/**/seeds/**/*.tmp
runs/**/*.prelock.bak
runs/**/*.lock
runs/**/plans/round_*.tmp

# ── 语料与本地权重（体积大，按 README 自行获取）──────────────────────────────
datasets/ao_ready_v1/
datasets/data/
models/
*.pdf
*.docx
*.pptx

# ── ES 与编辑器 ────────────────────────────────────────────────────────────
data/es/
*.log
!runs/**/*.log
.idea/
.vscode/
.DS_Store

# ── 其它 ──────────────────────────────────────────────────────────────────
*.bak
*.orig
*.rej
tmp/
scratch/