# 大文件走 Git LFS：定版 run 的检索缓存与判题应答合计约 210 MB。
# 首次使用：git lfs install
runs/**/retrieval_cache.json filter=lfs diff=lfs merge=lfs -text
runs/**/jev_responses.jsonl filter=lfs diff=lfs merge=lfs -text
runs/**/vision_facts.jsonl  filter=lfs diff=lfs merge=lfs -text
runs/**/*.jsonl             filter=lfs diff=lfs merge=lfs -text

# 二进制类文件统一不参与文本 diff
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.tif  binary
*.tiff binary

# 文本文件的规范化
*.py   text eol=lf
*.sh   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.jsonl text eol=lf