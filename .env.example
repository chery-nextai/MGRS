# MGRS 环境变量模板：`cp .env.example .env` 后按需填写。
# scripts/*.sh 会自动 `set -a; . ./.env`；直接跑 python 时请自行 export 或使用 direnv。
# 所有项都可只通过环境变量提供，仓库内不含任何默认地址、密钥或机器路径。

# ─────────────────────────────────────────────────────────────────────────────
# 1. 判题器（DQCR 双题：support 三档 + redundancy 四档）
# ─────────────────────────────────────────────────────────────────────────────
# 后端：jev（原生 JEV 网关协议）| openai_chat（任意 OpenAI 兼容 /chat/completions）
MGRS_JUDGE_BACKEND=jev

# jev 模式填到 .../v1/systemone；openai_chat 模式填到 .../v1（末尾不要带 /chat/completions）
MGRS_JUDGE_API_URL=
# 判题模型名。会写进 manifest 的 jev_model 字段，换模型 = 换评分基线
MGRS_JUDGE_MODEL=

# 密钥「变量名」而非密钥本身：适配层去读这个环境变量里的值
MGRS_JUDGE_API_KEY_ENV=JEV_API_KEY
JEV_API_KEY=

# 请求指纹前缀（指纹只含它 + state，不含 URL/模型名）。
# ⚠ 换后端或换模型时必须同时换一个 tag，否则会静默命中另一基线的应答缓存。
# 定版实验为 jev_ao，复现随附产物请勿改动。
MGRS_JUDGE_SCHEMA_TAG=jev_ao

MGRS_JUDGE_TIMEOUT=110
# 以下仅 openai_chat 模式生效
MGRS_JUDGE_CHAT_PATH=/chat/completions
MGRS_JUDGE_TEMPERATURE=0
MGRS_JUDGE_MAX_TOKENS=1024
# 端点确实支持 response_format={"type":"json_object"} 时才设 1，否则可能 400
MGRS_JUDGE_JSON_MODE=0
# 需要额外请求头的网关，用 JSON 传入，例如 {"X-Api-Version":"2"}
MGRS_JUDGE_EXTRA_HEADERS=

# ─────────────────────────────────────────────────────────────────────────────
# 2. OpenAI 兼容 LLM：图像转写（vision）与 LLM 控制器（decision）
# ─────────────────────────────────────────────────────────────────────────────
LLM_API_BASE=
LLM_API_KEY=
# 通用默认模型；实际调用分别用下面两个具体模型名覆盖
LLM_MODEL=
# 图像事实转写模型（定版：qwen3.7-flash，prompt=image_facts_no_question_v1）
MGRS_VISION_MODEL=qwen3.7-flash
# LLM 控制器的决策模型（定版：qwen3.8-max，temperature 0.2）
MGRS_DECISION_MODEL=qwen3.8-max
LLM_TIMEOUT=180
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BACKOFF=2
# 图像转写并发（按端点限流调整）
VISION_WORKERS=4

# ─────────────────────────────────────────────────────────────────────────────
# 3. 奖励口径（定版，勿改）
# ─────────────────────────────────────────────────────────────────────────────
# DQCR 双题复合：E[R]=Σw·P，score = P(support)·(1 − γ·E[R])
REDUNDANCY_GAMMA=0.5
REDUNDANCY_MODE=scale

# ─────────────────────────────────────────────────────────────────────────────
# 4. Elasticsearch
# ─────────────────────────────────────────────────────────────────────────────
# 主入口按数据集自动取端口（techslides/finance_en=29200，pharmaceuticals=19200），一般不用填；
# 需要覆盖时再解开下一行（--es-url 优先级更高）。
# AO_EXPLORE_ES_URL=http://127.0.0.1:29200
ES_USER=
ES_PASSWORD=
ES_VERIFY_CERTS=true

# ─────────────────────────────────────────────────────────────────────────────
# 5. 语料与索引前缀
# ─────────────────────────────────────────────────────────────────────────────
# 语料根目录（默认 <repo>/datasets/ao_ready_v1）
MGRS_AO_CORPUS_ROOT=
# 单数据集绝对路径覆盖；pharmaceuticals 的交接包结构不同，通常必须单独指定
# MGRS_AO_CORPUS_DIR_TECHSLIDES=/data/ao_ready_v1/techslides/data
# MGRS_AO_CORPUS_DIR_FINANCE_EN=/data/ao_ready_v1/finance_en/data
# MGRS_AO_CORPUS_DIR_PHARMACEUTICALS=/data/ao_format_v1/pharmaceuticals
# 自建索引时覆盖数据集自带的索引前缀（生成 <prefix>_text_embedding_v2_<backend>）
# MGRS_INDEX_PREFIX_TECHSLIDES=my_ao_techslides_v1
# MGRS_INDEX_PREFIX_FINANCE_EN=my_ao_finance_en_v1
# MGRS_INDEX_PREFIX_PHARMACEUTICALS=my_ao_pharma_v1

# ─────────────────────────────────────────────────────────────────────────────
# 6. 本地编码器权重
# ─────────────────────────────────────────────────────────────────────────────
# 权重根目录（默认 <repo>/models），目录名默认如下，可直接放子目录或逐个覆盖
MGRS_EMBED_MODEL_ROOT=
# MGRS_EMBED_MODEL_DIR_JINA_NANO=<root>/jinaai--jina-embeddings-v5-omni-nano
# MGRS_EMBED_MODEL_DIR_JINA_SMALL=<root>/jinaai--jina-embeddings-v5-omni-small
# MGRS_EMBED_MODEL_DIR_QWEN3_VL_2B=<root>/Qwen3-VL-Embedding-2B
AO_EMBEDDING_DEVICE=cuda
CUDA_VISIBLE_DEVICES=
# 云端图像编码（AO_IMAGE_EMBEDDING_BACKEND=qwen3_vl 时走 LLM_API_BASE + LLM_API_KEY）
AO_IMAGE_EMBEDDING_BACKEND=qwen3_vl
AO_IMAGE_EMBEDDING_MODEL=qwen3-vl-embedding

# ─────────────────────────────────────────────────────────────────────────────
# 7. 运行目录（默认都在仓库内，一般不用改）
# ─────────────────────────────────────────────────────────────────────────────
# AO_EXPLORE_RUNS_DIR=<repo>/runs
# AO_EXPLORE_MEMORY_PATH=<repo>/memory/experiences.jsonl
# AO_EXPLORE_SUPPORT_CACHE_PATH=<repo>/memory/support_scores.json
# AO_EXPLORE_EVAL_CONCURRENCY=3

# ─────────────────────────────────────────────────────────────────────────────
# 8. 历史 relay 部署（默认不用；判题走 --jev-api 直连）
# ─────────────────────────────────────────────────────────────────────────────
# MGRS_RELAY_URL=
# MGRS_RELAY_TOKEN_FROM=